{
  "name": "papa-parade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:playtest": "vite build --mode playtest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "golden:update": "GOLDEN_UPDATE=1 vitest run tests/golden",
    "e2e": "playwright test",
    "content:check": "tsx tools/content/checkContent.ts",
    "content:schemas": "tsx tools/content/emitSchemas.ts",
    "sim": "tsx tools/sim/runSim.ts",
    "sim:replay": "tsx tools/sim/replaySim.ts",
    "assets:export": "tsx tools/assets/exportLevel.ts",
    "assets:extract": "tsx tools/assets/extractLevelGeometry.ts",
    "assets:optimize": "tsx tools/assets/optimizeGlb.ts",
    "assets:audio": "tsx tools/audio/makePlaceholderAudio.ts",
    "story:new": "bash tools/git/newStoryWorktree.sh",
    "ci": "npm run typecheck && npm run lint && npm run content:check && npm run test:coverage && npm run e2e && npm run build:playtest"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "gltfpack": "1.3.0",
    "tsx": "4.23.15",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
