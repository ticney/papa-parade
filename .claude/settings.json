{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main-commit.sh",
            "statusMessage": "Checking the story-branch rule"
          }
        ]
      }
    ]
  }
}
