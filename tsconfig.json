{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Layer aliases (no baseUrl: removed in TS 7). `@sim` is exact on purpose: other layers only use the sim's public API. */
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@content/*": ["./src/content/*"],
      "@sim": ["./src/sim/index.ts"],
      "@bots/*": ["./src/bots/*"],
      "@client/*": ["./src/client/*"],
      "@platform/*": ["./src/platform/*"],
      "@debug/*": ["./src/debug/*"]
    }
  },
  "include": ["src", "tests", "tools", "*.config.ts"],
  "exclude": ["tests/architecture/fixtures", "node_modules", "dist"]
}
