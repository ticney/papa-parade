{
  "$schema": "./_schemas/feedback.schema.json",
  "buses": {
    "music": { "gainPct": 50 },
    "sfx": { "gainPct": 90 },
    "voice": { "gainPct": 80 },
    "ui": { "gainPct": 80 }
  },
  "haptics": {
    "light": { "patternMs": [15] },
    "medium": { "patternMs": [30] },
    "heavy": { "patternMs": [60] }
  },
  "loops": {
    "babble": { "clip": "baby_babble_loop", "bus": "voice", "gainPct": 100, "fadeMs": 80 },
    "music": { "clip": "music_crawler_calm", "bus": "music", "gainPct": 100, "fadeMs": 400 }
  },
  "cues": {
    "papa_bump": {
      "audio": { "clip": "papa_bump", "bus": "sfx", "gainPct": 100 },
      "visual": { "kind": "soundWave", "anchor": "papa", "maxRadiusM": 0.6, "durationMs": 350 },
      "haptic": "light"
    },
    "countdown_tick": { "haptic": "light" },
    "tel_outlet": {
      "audio": { "clip": "tel_outlet", "bus": "sfx", "gainPct": 90 },
      "visual": { "kind": "soundWave", "anchor": "threat", "maxRadiusM": 0.6, "durationMs": 400 },
      "haptic": "light"
    },
    "resp_parry": {
      "audio": { "clip": "resp_parry", "bus": "sfx", "gainPct": 100 },
      "visual": { "kind": "soundWave", "anchor": "threat", "maxRadiusM": 0.8, "durationMs": 350 },
      "haptic": "medium"
    },
    "resp_parry_perfect": {
      "audio": { "clip": "resp_parry_perfect", "bus": "sfx", "gainPct": 100 },
      "visual": { "kind": "soundWave", "anchor": "threat", "maxRadiusM": 1.2, "durationMs": 450 },
      "haptic": "heavy"
    },
    "gag_outlet": {
      "audio": { "clip": "gag_outlet", "bus": "sfx", "gainPct": 100 },
      "visual": { "kind": "soundWave", "anchor": "threat", "maxRadiusM": 1.0, "durationMs": 500 },
      "haptic": "heavy"
    }
  },
  "events": {
    "PapaBlocked": "papa_bump",
    "CountdownTicked": "countdown_tick"
  }
}
