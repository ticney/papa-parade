{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this JSON Schema: editor autocomplete only, ignored by the loader."
    },
    "buses": {
      "type": "object",
      "properties": {
        "music": {
          "type": "object",
          "properties": {
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Bus volume, in percent (100 = full)."
            }
          },
          "required": [
            "gainPct"
          ],
          "additionalProperties": false,
          "description": "The music bus."
        },
        "sfx": {
          "type": "object",
          "properties": {
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Bus volume, in percent (100 = full)."
            }
          },
          "required": [
            "gainPct"
          ],
          "additionalProperties": false,
          "description": "The sound-effects bus: responses, bumps, gags."
        },
        "voice": {
          "type": "object",
          "properties": {
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Bus volume, in percent (100 = full)."
            }
          },
          "required": [
            "gainPct"
          ],
          "additionalProperties": false,
          "description": "The voice bus: the baby, Mama."
        },
        "ui": {
          "type": "object",
          "properties": {
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Bus volume, in percent (100 = full)."
            }
          },
          "required": [
            "gainPct"
          ],
          "additionalProperties": false,
          "description": "The interface bus."
        }
      },
      "required": [
        "music",
        "sfx",
        "voice",
        "ui"
      ],
      "additionalProperties": false,
      "description": "Volume of each bus: the mix. The player volumes of story 2.8 multiply it."
    },
    "haptics": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "patternMs": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "description": "`navigator.vibrate` pattern, in ms: vibrate, pause, vibrate, pause..."
            }
          },
          "required": [
            "patternMs"
          ],
          "additionalProperties": false,
          "description": "A light tap: a tick, a bump."
        },
        "medium": {
          "type": "object",
          "properties": {
            "patternMs": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "description": "`navigator.vibrate` pattern, in ms: vibrate, pause, vibrate, pause..."
            }
          },
          "required": [
            "patternMs"
          ],
          "additionalProperties": false,
          "description": "A medium tap: a response."
        },
        "heavy": {
          "type": "object",
          "properties": {
            "patternMs": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "description": "`navigator.vibrate` pattern, in ms: vibrate, pause, vibrate, pause..."
            }
          },
          "required": [
            "patternMs"
          ],
          "additionalProperties": false,
          "description": "A heavy tap: a gag."
        }
      },
      "required": [
        "light",
        "medium",
        "heavy"
      ],
      "additionalProperties": false,
      "description": "The vibration of each kind. A browser without vibration ignores them."
    },
    "loops": {
      "type": "object",
      "properties": {
        "babble": {
          "type": "object",
          "properties": {
            "clip": {
              "type": "string",
              "pattern": "^(tel|resp|gag|baby|papa|env|ui|music)_[a-z0-9]+(_[a-z0-9]+)*$",
              "description": "File name without extension: `public/assets/audio/<clip>.m4a`."
            },
            "bus": {
              "type": "string",
              "enum": [
                "music",
                "sfx",
                "voice",
                "ui"
              ],
              "description": "Bus the sound goes through."
            },
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Loop volume on its bus, in percent."
            },
            "fadeMs": {
              "type": "number",
              "minimum": 0,
              "description": "Fade in when the loop starts and fade out when it stops, in ms."
            }
          },
          "required": [
            "clip",
            "bus",
            "gainPct",
            "fadeMs"
          ],
          "additionalProperties": false,
          "description": "The baby babbles while `baby.babbling` (its stop is the silence)."
        },
        "music": {
          "type": "object",
          "properties": {
            "clip": {
              "type": "string",
              "pattern": "^(tel|resp|gag|baby|papa|env|ui|music)_[a-z0-9]+(_[a-z0-9]+)*$",
              "description": "File name without extension: `public/assets/audio/<clip>.m4a`."
            },
            "bus": {
              "type": "string",
              "enum": [
                "music",
                "sfx",
                "voice",
                "ui"
              ],
              "description": "Bus the sound goes through."
            },
            "gainPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Loop volume on its bus, in percent."
            },
            "fadeMs": {
              "type": "number",
              "minimum": 0,
              "description": "Fade in when the loop starts and fade out when it stops, in ms."
            }
          },
          "required": [
            "clip",
            "bus",
            "gainPct",
            "fadeMs"
          ],
          "additionalProperties": false,
          "description": "The level music, for the whole level."
        }
      },
      "required": [
        "babble",
        "music"
      ],
      "additionalProperties": false,
      "description": "Sounds driven by a state, not by an event: they are not cues."
    },
    "resultScreen": {
      "type": "object",
      "properties": {
        "rowCountUpMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "How long one score row counts up from 0 to its total, in real ms."
        },
        "rowStaggerMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Delay between the start of one score row and the next, in real ms."
        },
        "starsDelayMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Pause between the last row landing and the first star, in real ms."
        },
        "starIntervalMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Delay between two stamped stars, in real ms."
        },
        "actionsDelayMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Pause between the last star (or the last row, with no star) and the buttons, in real ms."
        },
        "inputGraceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "After the screen comes up, and again after the buttons come up, presses that start within this many real ms skip nothing and press nothing, so that taps still mashing for the last parry do not skip the note or hit « Rejouer »; 0 turns it off."
        }
      },
      "required": [
        "rowCountUpMs",
        "rowStaggerMs",
        "starsDelayMs",
        "starIntervalMs",
        "actionsDelayMs",
        "inputGraceMs"
      ],
      "additionalProperties": false,
      "description": "The sequence of the Result screen (story 1.22): rows, then stars, then buttons. Real time: the sim never reads it."
    },
    "cues": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "object",
            "properties": {
              "clip": {
                "type": "string",
                "pattern": "^(tel|resp|gag|baby|papa|env|ui|music)_[a-z0-9]+(_[a-z0-9]+)*$",
                "description": "File name without extension: `public/assets/audio/<clip>.m4a`."
              },
              "bus": {
                "type": "string",
                "enum": [
                  "music",
                  "sfx",
                  "voice",
                  "ui"
                ],
                "description": "Bus the sound goes through."
              },
              "gainPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Cue volume on its bus, in percent."
              }
            },
            "required": [
              "clip",
              "bus",
              "gainPct"
            ],
            "additionalProperties": false,
            "description": "The sound of a cue, played once."
          },
          "layers": {
            "description": "Extra sounds played at the same moment as `audio`, in order (the baby laughs on a perfect). A cue with layers needs an `audio`; a layer has no ring, vibration or cue of its own.",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clip": {
                  "type": "string",
                  "pattern": "^(tel|resp|gag|baby|papa|env|ui|music)_[a-z0-9]+(_[a-z0-9]+)*$",
                  "description": "File name without extension: `public/assets/audio/<clip>.m4a`."
                },
                "bus": {
                  "type": "string",
                  "enum": [
                    "music",
                    "sfx",
                    "voice",
                    "ui"
                  ],
                  "description": "Bus the sound goes through."
                },
                "gainPct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Cue volume on its bus, in percent."
                }
              },
              "required": [
                "clip",
                "bus",
                "gainPct"
              ],
              "additionalProperties": false,
              "description": "The sound of a cue, played once."
            }
          },
          "visual": {
            "description": "The visual twin of the sound: a diegetic effect in the 3D world, or the UI element that fired the event.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "soundWave",
                    "description": "A ring on the floor that grows and fades."
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "papa",
                      "baby",
                      "threat",
                      "object"
                    ],
                    "description": "Whose position the ring starts from. `threat` is the threat the event names; only for cues a threat def points at. `object` is the object the event names (`objectId`); only for cues a disruption def points at."
                  },
                  "maxRadiusM": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3,
                    "description": "Radius of the ring when it is gone, in metres."
                  },
                  "durationMs": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "How long the ring takes to grow and fade, in sim ms."
                  },
                  "pulses": {
                    "description": "Rings sent one after the other (2 or 3); absent means one ring.",
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 3
                  },
                  "pulseIntervalMs": {
                    "description": "Delay between the start of two pulses, in sim ms. Needs `pulses`, and the reverse.",
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "anchor",
                  "maxRadiusM",
                  "durationMs"
                ],
                "additionalProperties": false,
                "description": "The visual twin of a sound."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "uiElement",
                    "description": "The UI element that fired the event is the visual twin (a stamped star): the director draws nothing. Only for a client event."
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "description": "The visual twin of a sound that a screen element already shows."
              }
            ]
          },
          "haptic": {
            "description": "Vibration played with the cue, one of `haptics`.",
            "type": "string",
            "enum": [
              "light",
              "medium",
              "heavy"
            ]
          },
          "flash": {
            "description": "A screen flash, the mark of a perfect response. It also counts as a visual twin of the sound.",
            "type": "object",
            "properties": {
              "peakOpacityPct": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Opacity of the flash at its start, in percent."
              },
              "durationMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 334,
                "description": "How long the flash takes to fade out, in real ms. At most the 3 Hz interval, so a flash never restarts on itself."
              }
            },
            "required": [
              "peakOpacityPct",
              "durationMs"
            ],
            "additionalProperties": false
          },
          "fx": {
            "description": "Plays the `feel.fx.<preset>` juice: shake, particles and, for `perfect`, the stamp; at the cue ring anchor.",
            "type": "string",
            "enum": [
              "success",
              "perfect",
              "gag"
            ]
          }
        },
        "additionalProperties": false,
        "description": "What the player hears, sees and feels for one signal. Every audio has a visual and a haptic."
      },
      "description": "Every cue, by id. Threats will point at these ids."
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      },
      "description": "Event name -> cue id. A sim event (`PapaBlocked`) or a client one (`CountdownTicked`); `npm run content:check` refuses any other name."
    }
  },
  "required": [
    "buses",
    "haptics",
    "loops",
    "resultScreen",
    "cues",
    "events"
  ],
  "additionalProperties": false,
  "description": "The multimodal feedback table (ADR-006): which event plays which sound, ring, vibration and camera effect."
}
